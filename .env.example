# Google Gemini AI API Key (Required for live LLM review; deterministic ATS fallback runs if unset)
GOOGLE_API_KEY=your_google_gemini_api_key_here

# OpenRouter API Key (Optional)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Database Configuration (leave commented to use local SQLite resume_data.db / feedback.db)
# For cloud PostgreSQL (Render, Railway, Docker):
# DATABASE_URL=postgresql://user:password@host:5432/resumeanalyzer

# Optional Admin Credentials (or create a hashed admin via Admin Portal setup / scripts/create_admin.py)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Application Settings
DEBUG=False
LOG_LEVEL=INFO
